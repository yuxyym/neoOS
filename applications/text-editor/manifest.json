{
  "id": "org.neoos.text-editor",
  "name": "Text Editor",
  "version": "1.0.0",
  "description": "Tabbed text and code editor with find and replace",
  "icon": "icon.svg",
  "main": "main.js",
  "minApiVersion": "1.0",
  "categories": ["Utilities", "Productivity"],
  "permissions": ["fs.read:~/*", "fs.write:~/*"],
  "network": [],
  "instance": "single",
  "autostart": false,
  "exitWhenLastWindowCloses": true,
  "associations": ["text/*", "application/json"],
  "intents": [],
  "contributes": {}
}
